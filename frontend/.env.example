# MyCryptoSignal web (apps/web) — build-time public env vars.
# Copy to `.env` for local dev, or set in CI / Cloudflare Pages build settings.
# These are PUBLIC (shipped to the browser). NEVER put a real secret here.

# Worker API base URL (no trailing slash).
PUBLIC_API_BASE=https://api.mycryptosignal.workers.dev

# Optional public read-only token for the site's own server-side/public reads.
# This is a limited, rotate-able token that is intentionally exposed to browsers
# (see PRD Q9). Leave empty to render graceful empty states.
PUBLIC_API_KEY=
