---
// Command palette — ⌘K / Ctrl-K over a build-time static index.
//
// Plain <dialog> + listbox, no library. The index (every coin + every page) ships
// as a JSON island; filtering happens in the browser with no network call. The
// dialog button itself lives in the navbar (Nav.astro) and opens this dialog.
import type { SearchEntry } from '../lib/search';

interface Props {
  index: SearchEntry[];
}
const { index } = Astro.props;
---

<dialog id="cmdk" class="cmdk" aria-modal="true" aria-labelledby="cmdk-title">
  <div class="cmdk-panel">
    <h2 id="cmdk-title" class="visually-hidden">Search coins and pages</h2>
    <input
      id="cmdk-input"
      class="cmdk-input"
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="cmdk-list"
      aria-autocomplete="list"
      aria-label="Search coins and pages"
      autocomplete="off"
      spellcheck="false"
      placeholder="Search coins and pages…"
    />
    <ul id="cmdk-list" class="cmdk-list" role="listbox" aria-label="Results"></ul>
    <p class="cmdk-hint mono muted" id="cmdk-hint" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span><span><kbd>↵</kbd> open</span><span><kbd>esc</kbd> close</span>
    </p>
  </div>
</dialog>

<script type="application/json" id="search-index" set:html={JSON.stringify(index)}></script>

<script>
  import { coinIconHtml } from '../lib/coin-icon';

  (function () {
    const dialog = document.getElementById('cmdk') as HTMLDialogElement | null;
    const input = document.getElementById('cmdk-input') as HTMLInputElement | null;
    const listEl = document.getElementById('cmdk-list') as HTMLElement | null;
    const indexEl = document.getElementById('search-index');
    if (!dialog || !input || !listEl || !indexEl) return;

    const index = JSON.parse(indexEl.textContent || '[]') as { t: string; s: string; u: string; k: string; f?: string | null }[];
    const openers = document.querySelectorAll<HTMLElement>('[data-cmdk-open]');
    let lastFocus: HTMLElement | null = null;
    let results: typeof index = [];
    let active = 0;

    const esc = (s: string): string =>
      s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);

    function score(e: { t: string; s: string }, q: string): number {
      const t = e.t.toLowerCase();
      const s = e.s.toLowerCase();
      if (t === q) return 100;
      if (t.startsWith(q)) return 60;
      if (t.includes(q)) return 40;
      if (s.startsWith(q)) return 20;
      if (s.includes(q)) return 12;
      return 0;
    }

    function setActive(i: number): void {
      active = i;
      const opts = listEl!.querySelectorAll<HTMLElement>('.cmdk-opt');
      opts.forEach((o, n) => o.setAttribute('aria-selected', n === active ? 'true' : 'false'));
      const cur = opts[active];
      if (cur) {
        input!.setAttribute('aria-activedescendant', cur.id);
        cur.scrollIntoView({ block: 'nearest' });
      }
    }

    function render(query: string): void {
      const q = query.trim().toLowerCase();
      results = !q
        ? index.slice(0, 12)
        : index
            .map((e) => ({ e, sc: score(e, q) }))
            .filter((x) => x.sc > 0)
            .sort((a, b) => b.sc - a.sc || a.e.t.localeCompare(b.e.t))
            .slice(0, 12)
            .map((x) => x.e);

      if (!results.length) {
        listEl!.innerHTML = `<li class="cmdk-opt cmdk-none" role="presentation">Nothing matches — try another symbol or page.</li>`;
        input!.removeAttribute('aria-activedescendant');
        return;
      }
      listEl!.innerHTML = results
        .map(
          (e, i) =>
            `<li role="option" id="cmdk-opt-${i}" class="cmdk-opt" aria-selected="false" data-url="${esc(e.u)}">` +
            `<span class="cmdk-badge mono">${e.k === 'coin' ? 'coin' : 'page'}</span>` +
            `${e.k === 'coin' ? coinIconHtml(e.f ?? null, e.t) : ''}` +
            `<span class="cmdk-t mono">${esc(e.t)}</span>` +
            `<span class="cmdk-s muted">${esc(e.s)}</span></li>`,
        )
        .join('');
      setActive(0);
    }

    function go(url: string): void {
      dialog!.close();
      window.location.href = url;
    }

    function open(): void {
      lastFocus = document.activeElement as HTMLElement | null;
      if (typeof dialog!.showModal === 'function') dialog!.showModal();
      else dialog!.setAttribute('open', '');
      input!.value = '';
      render('');
      input!.focus();
    }

    openers.forEach((b) => b.addEventListener('click', open));

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
        e.preventDefault();
        if (dialog!.open) dialog!.close();
        else open();
      }
    });

    input.addEventListener('input', () => render(input.value));

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (results.length) setActive((active + 1) % results.length);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (results.length) setActive((active - 1 + results.length) % results.length);
      } else if (e.key === 'Home') {
        e.preventDefault();
        if (results.length) setActive(0);
      } else if (e.key === 'End') {
        e.preventDefault();
        if (results.length) setActive(results.length - 1);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const cur = results[active];
        if (cur) go(cur.u);
      }
    });

    listEl.addEventListener('click', (e) => {
      const t = e.target as HTMLElement | null;
      const opt = t && t.closest ? (t.closest('.cmdk-opt') as HTMLElement | null) : null;
      const url = opt?.dataset.url;
      if (url) go(url);
    });

    listEl.addEventListener('mousemove', (e) => {
      const t = e.target as HTMLElement | null;
      const opt = t && t.closest ? (t.closest('.cmdk-opt') as HTMLElement | null) : null;
      if (!opt) return;
      const opts = Array.from(listEl.querySelectorAll('.cmdk-opt'));
      const i = opts.indexOf(opt);
      if (i >= 0 && i !== active) setActive(i);
    });

    // Native <dialog> handles Escape + focus trapping; restore focus on close.
    dialog.addEventListener('close', () => {
      if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
    });
  })();
</script>
