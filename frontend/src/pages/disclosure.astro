---
import Base from '../layouts/Base.astro';
import { SITE, absoluteUrl } from '../lib/site';

const updated = '12 October 2026';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'How we make money',
  url: absoluteUrl('/disclosure'),
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: absoluteUrl('/') },
  publisher: { '@type': 'Organization', name: SITE.name, url: absoluteUrl('/') },
};
---

<Base
  title="How we make money"
  description="What is for sale at MyCryptoSignal (affiliate commissions and sponsorships) and what is not: our signals, direction calls and briefs never receive commercial input."
  path="/disclosure"
  jsonLd={[ld]}
>
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">Transparency</p>
      <h1>How we make money</h1>
      <p class="updated">Last updated: {updated}</p>

      <p>
        MyCryptoSignal is owned and operated by {SITE.operator}. This page says plainly where our money
        comes from, and — just as importantly — where it does not.
      </p>

      <h2>What is for sale</h2>
      <ul>
        <li>
          <strong>Affiliate commissions.</strong> If you sign up for a tool through a link on our
          <a href="/tools-and-partners">Tools &amp; Partners</a> page, we may be paid a commission. It
          costs you nothing extra. Every compensated link is labelled with the same disclosure, right next
          to the link.
        </li>
        <li>
          <strong>Sponsorships.</strong> From time to time a sponsor may pay to be named on our
          monetization page. Sponsorship buys visibility there — never editorial coverage.
        </li>
        <li>
          <strong>The data API.</strong> Our public market-data API has paid tiers. That is a product we
          run and support; it is separate from our editorial content.
        </li>
      </ul>

      <h2>What is not for sale</h2>
      <ul>
        <li>
          <strong>Our signals.</strong> The daily direction words (Rising, Falling, Steady, Choppy) describe
          what our own numbers show. They receive <strong>no commercial input</strong> and cannot be bought,
          suppressed, or shaped by any partner.
        </li>
        <li>
          <strong>Our direction calls and briefs.</strong> Market briefs are written from our own collected
          data. No advertiser or partner influences what we publish, and we do not publish paid articles.
        </li>
        <li>
          <strong>Our news.</strong> News digests summarise and link to the original source. They are never
          sponsored and never mixed with a commercial link.
        </li>
      </ul>

      <h2>The firewall rule, in one sentence</h2>
      <p>
        Commercial and affiliate links live <strong>only</strong> on the
        <a href="/tools-and-partners">Tools &amp; Partners</a> page — never on a signal, brief, news or
        market page, and never next to a direction word.
      </p>

      <h2>Not investment advice</h2>
      <p>
        Nothing on this site is financial, investment, legal or tax advice. A commission is never a
        recommendation. Crypto markets are volatile and carry significant risk — do your own research. See
        our <a href="/disclaimer">Disclaimer</a> and <a href="/editorial-policy">Editorial Policy</a>.
      </p>
    </div>
  </section>
</Base>
