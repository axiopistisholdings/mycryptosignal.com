name = "mycryptosignal"
main = "src/index.js"
compatibility_date = "2024-01-01"

[env.production]
name = "mycryptosignal"
route = "https://mycryptosignal.YOUR-SUBDOMAIN.workers.dev/*"

# KV Namespaces - Replace with your actual namespace IDs from Cloudflare dashboard
kv_namespaces = [
  { binding = "CRYPTO_SIGNALS", id = "YOUR_KV_NAMESPACE_ID", preview_id = "YOUR_PREVIEW_KV_NAMESPACE_ID" }
]

# D1 Database - Replace with your actual database ID from Cloudflare dashboard
[[d1_databases]]
binding = "DB"
database_name = "mycryptosignal-db"
database_id = "YOUR_D1_DATABASE_ID"

# Secret variables (set via: wrangler secret put <NAME>)
# These should NOT be committed to the repository
# Run these commands to set them:
# wrangler secret put COINGECKO_API_KEY
# wrangler secret put ALCHEMY_API_KEY
# wrangler secret put INFURA_API_KEY
# wrangler secret put TWITTER_API_KEY
# wrangler secret put TWITTER_API_SECRET
# wrangler secret put TWITTER_ACCESS_TOKEN
# wrangler secret put TWITTER_ACCESS_TOKEN_SECRET
# wrangler secret put RESEND_API_KEY
# wrangler secret put CLOUDFLARE_ACCOUNT_ID
# wrangler secret put CLOUDFLARE_API_TOKEN

# Environment variables (non-sensitive)
[vars]
ENVIRONMENT = "production"
SIGNAL_UPDATE_INTERVAL = "3600000"
RATE_LIMIT_FREE = "10"
RATE_LIMIT_PREMIUM = "100"
