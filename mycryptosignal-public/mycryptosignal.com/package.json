{
  "name": "mycryptosignal-backend",
  "version": "1.0.0",
  "description": "AI-powered crypto signal engine on Cloudflare Workers",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:create": "wrangler d1 create mycryptosignal-db",
    "db:init": "wrangler d1 execute mycryptosignal-db --file=./schema.sql",
    "db:seed": "wrangler d1 execute mycryptosignal-db --file=./scripts/seed-coins.sql",
    "db:query": "wrangler d1 execute mycryptosignal-db --command",
    "kv:create": "wrangler kv:namespace create KV",
    "health": "node scripts/health-check.js",
    "create-api-key": "node scripts/create-api-key.js",
    "test": "node --test tests/**/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/**/*.test.js",
    "test:watch": "node --test --watch tests/**/*.test.js",
    "lint": "eslint src/**/*.js scripts/**/*.js",
    "lint:fix": "eslint src/**/*.js scripts/**/*.js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\""
  },
  "keywords": [
    "crypto",
    "trading",
    "signals",
    "ai",
    "cloudflare",
    "workers"
  ],
  "author": "Axiopistis Holdings",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.60.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  }
}
